{
  "version": 2,
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "echo 'No build step required'",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/sw.js", "destination": "/sw.js" }
  ],
  "headers": [
    {
      "source": "/assets/video/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
